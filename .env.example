# Generate a secret: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY= 
# Local HTTP development only. Use true with HTTPS in deployment.
SESSION_COOKIE_SECURE=false
# Nginx entry point: http://localhost:8080
GATEWAY_PORT=8080
# Explicit opt-in for local LMS testing. Keep false in deployment.
DEV_MODE=false
# Exact private test hostnames accepted only when DEV_MODE=true.
LMS_PRIVATE_HOSTS=moodle.tutor.localhost
# Optional trusted local CA path inside the LMS containers (development only).
LMS_CA_FILE=
# Optional restriction to exact LMS hostnames. Blank accepts public HTTPS hosts;
# private/internal IPs are blocked unless DEV_MODE enables an exact test hostname.
LMS_ALLOWED_HOSTS=
# Keep this key stable and back it up separately from the LMS database.
# Generate: python3 -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
LMS_ENCRYPTION_KEY=
LMS_SYNC_TIMEZONE=Europe/Dublin
LMS_SYNC_HOUR=2
LMS_DB_PASSWORD=password
# Shared only by college_svc, lms_svc and lms_worker for academic catalogue APIs.
# Generate: python3 -c 'import secrets; print(secrets.token_hex(32))'
COLLEGE_SYNC_TOKEN=
PUBLIC_BASE_URL=http://localhost:8080
