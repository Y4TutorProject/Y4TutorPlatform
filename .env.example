# Generate a secret: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY= 
# Local HTTP development only. Use true with HTTPS in deployment.
SESSION_COOKIE_SECURE=false
# Nginx entry point: http://localhost:8080
GATEWAY_PORT=8080
# Optional restriction to exact LMS hostnames. Blank accepts public HTTPS hosts;
# private/internal IPs are always blocked, including after DNS resolution.
LMS_ALLOWED_HOSTS=
# Keep this key stable and back it up separately from the LMS database.
# Generate: python3 -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
LMS_ENCRYPTION_KEY=
LMS_SYNC_TIMEZONE=Europe/Dublin
LMS_SYNC_HOUR=2
LMS_DB_PASSWORD=password
PUBLIC_BASE_URL=http://localhost:8080
